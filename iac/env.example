# /etc/news-app/env — news-app.service が読む環境変数(chmod 600)
# POST /v1/static が返す公開URLの起点(変更禁止)
AP_ROOT=https://matome.folks-chat.com
AP_PORT=8000
DB_USER=matome
DB_PASSWORD=CHANGE_ME_DB
DB_HOST=127.0.0.1
DB_DATABASE=matome
DB_PORT=3306
KVS_PASSWORD=CHANGE_ME_REDIS
KVS_HOST=127.0.0.1
KVS_DATABASE=0
KVS_PORT=6379
WD_HOST=127.0.0.1
WD_PORT=80
MLM_DIR=/srv/models
MLM_NAME=izumi-lab/bert-small-japanese
MLM_INDEX_PATH=/srv/matome.ann
# /v1/stock 系の保護トークン(openssl rand -hex 24)。stock.service のcurlと同じ値にする
CRON_TOKEN=CHANGE_ME_TOKEN
